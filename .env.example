# Twilio Credentials (Get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Test driver phone number (Twilio trial accounts can only call verified numbers)
TEST_DRIVER_PHONE=+91XXXXXXXXXX

# Reminder Settings
REMINDER_WINDOW_MINUTES=30
WINDOW_TOLERANCE_MINUTES=5
POLL_INTERVAL_SECONDS=30

# Webhook Base URL (Optional - if using ngrok for public Twilio status callbacks)
BASE_WEBHOOK_URL=http://localhost:8000

# Google Sheets Public CSV export URL (Optional - default uses local rides_data.csv)
# Example: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv
GOOGLE_SHEET_CSV_URL=

# Server Settings
HOST=127.0.0.1
PORT=8000
